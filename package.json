    "storage:setup": "tsx scripts/setup-storage.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix",
    "*.{js,mjs,cjs,ts,tsx,json,css,md}": "prettier --write"
  },
  "dependencies": {
