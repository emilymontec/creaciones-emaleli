generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enumeraciones
// ============================================================

enum EstadoPedido {
  NUEVO
  EN_REVISION
  ESPERANDO_CLIENTE
  DISENO_APROBADO
  EN_PRODUCCION
  EMPACADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoPersonalizacion {
  TEXTO
  NUMERO
  TEXTAREA
  LISTA
  COLOR
  CHECKBOX
  ARCHIVO
}

enum MetodoEnvio {
  RECOGER
  DOMICILIO
  TRANSPORTADORA
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
  AGOTADO
}

enum TipoPago {
  ANTICIPO
  ABONO
  PAGO_FINAL
}

enum EstadoFactura {
  PENDIENTE
  EMITIDA
  ANULADA
}

enum EstadoGuia {
  GENERADA
  EN_TRANSITO
  ENTREGADA
  DEVUELTA
}

enum OrigenArchivo {
  CLIENTE
  PRODUCCION
}

enum EstadoSolicitudCambio {
  ABIERTA
  EN_REVISION
  APROBADA
  RECHAZADA
  CERRADA
}

enum RolUsuario {
  ADMIN
  VENTAS
  PRODUCCION
  SOPORTE
}

enum TipoEventoTimeline {
  CREACION_PEDIDO
  CAMBIO_ESTADO
  PAGO_REGISTRADO
  ARCHIVO_ADJUNTO
  ENVIO_GENERADO
  COMENTARIO_INTERNO
  PRODUCCION_AVANCE
  COMENTARIO_CLIENTE
  SOLICITUD_CAMBIO
}

enum TipoMedioProduccion {
  IMAGEN
  VIDEO
}

enum VisibilidadComentario {
  INTERNO
  CLIENTE
}

enum OrigenSolicitudCambio {
  ADMIN
  CLIENTE
}

// ============================================================
// Entidades
// ============================================================

model Usuario {
  id           String      @id @default(cuid())
  username     String      @unique
  nombre       String
  email        String      @unique
  telefono     String?
  empresa      String?
  cargo        String?
  avatar       String?
  passwordHash String
  rol          RolUsuario  @default(ADMIN)
  activo       Boolean     @default(true)

  eventosTimeline EventoTimeline[]
  pagos           Pago[]
  avancesProduccion ProduccionAvance[]
  comentariosProduccion ComentarioProduccion[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Categoria {
  id          String    @id @default(cuid())
  nombre      String
  slug        String    @unique
  descripcion String?
  imagen      String?
  activo      Boolean   @default(true)
  orden       Int       @default(0)

  productos   Producto[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Producto {
  id                String            @id @default(cuid())
  nombre            String
  slug              String            @unique
  descripcionCorta  String?
  descripcionLarga  String?
  precioBase        Decimal           @db.Decimal(10, 2)
  precioDescuento   Decimal?          @db.Decimal(10, 2)
  seoTitulo         String?
  seoDescripcion    String?
  seoImagen         String?
  destacado         Boolean           @default(false)
  estado            EstadoProducto    @default(ACTIVO)
  tiempoProduccion  Int?

  categorias        Categoria[]

  imagenes          ProductoImagen[]
  variantes         ProductoVariante[]
  combinaciones     CombinacionVariante[]
  personalizaciones Personalizacion[]
  items             ItemPedido[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([estado])
}

model ProductoImagen {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  url        String
  principal  Boolean  @default(false)
  orden      Int      @default(0)

  @@index([productoId])
}

model ProductoVariante {
  id          String            @id @default(cuid())
  productoId  String
  producto    Producto          @relation(fields: [productoId], references: [id])
  nombre      String
  tipo        String
  imagen      String?
  precioExtra Decimal           @default(0) @db.Decimal(10, 2)
  orden       Int               @default(0)
  activo      Boolean           @default(true)

  items        ItemPedido[]
  combinaciones CombinacionVariante[]

  @@index([productoId])
}

model CombinacionVariante {
  id          String             @id @default(cuid())
  productoId  String
  producto    Producto           @relation(fields: [productoId], references: [id])
  opciones    ProductoVariante[]
  sku         String?
  precio      Decimal?           @db.Decimal(10, 2)
  stock       Int?
  activo      Boolean            @default(true)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([productoId])
}

model Personalizacion {
  id          String              @id @default(cuid())
  productoId  String
  producto    Producto            @relation(fields: [productoId], references: [id])
  nombre      String
  tipo        TipoPersonalizacion
  obligatorio Boolean             @default(false)
  precioExtra Decimal?            @db.Decimal(10, 2)
  opciones    Json?
  orden       Int                 @default(0)
  activo      Boolean             @default(true)

  @@index([productoId])
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  whatsapp  String
  email     String?
  empresa   String?
  ciudad    String?
  activo    Boolean  @default(true)

  pedidos   Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ciudad])
  @@index([whatsapp])
}

model Pedido {
  id              String        @id @default(cuid())
  codigo          String        @unique
  clienteId       String
  cliente         Cliente       @relation(fields: [clienteId], references: [id])
  estado          EstadoPedido  @default(NUEVO)
  metodoEnvio     MetodoEnvio   @default(RECOGER)
  total           Decimal       @db.Decimal(10, 2)
  saldoPendiente  Decimal       @db.Decimal(10, 2)
  ciudad          String
  direccion       String?
  observaciones   String?
  tokenSeguimiento String       @unique
  fechaPedido     DateTime      @default(now())

  items           ItemPedido[]
  pagos           Pago[]
  envios          Envio[]
  archivos        ArchivoAdjunto[]
  solicitudes     SolicitudCambio[]
  timeline        EventoTimeline[]
  avancesProduccion ProduccionAvance[]
  comentariosProduccion ComentarioProduccion[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ciudad])
  @@index([estado])
  @@index([clienteId])
}

model ItemPedido {
  id             String            @id @default(cuid())
  pedidoId       String
  pedido         Pedido            @relation(fields: [pedidoId], references: [id])
  productoId     String?
  producto       Producto?         @relation(fields: [productoId], references: [id])
  varianteId     String?
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id])
  nombreProducto String
  precioUnitario Decimal           @db.Decimal(10, 2)
  cantidad       Int
  personalizaciones Json?
  subtotal       Decimal           @db.Decimal(10, 2)

  @@index([pedidoId])
  @@index([productoId])
}

model Pago {
  id          String            @id @default(cuid())
  pedidoId    String
  pedido      Pedido            @relation(fields: [pedidoId], references: [id])
  tipo        TipoPago
  monto       Decimal           @db.Decimal(10, 2)
  fecha       DateTime          @default(now())
  metodo      String
  usuarioId   String?
  usuario     Usuario?          @relation(fields: [usuarioId], references: [id])
  comprobante ArchivoAdjunto?

  @@index([pedidoId])
}

model Envio {
  id            String       @id @default(cuid())
  pedidoId      String
  pedido        Pedido       @relation(fields: [pedidoId], references: [id])
  metodo        MetodoEnvio
  direccion     String?
  ciudad        String?
  destinatario  String?
  documento     String?
  telefono      String?
  numeroGuia    String?      @unique
  estadoGuia    EstadoGuia?
  fechaDespacho DateTime?
  fechaEntrega  DateTime?
  enlaceRastreo String?

  @@index([pedidoId])
}

model ArchivoAdjunto {
  id        String          @id @default(cuid())
  pedidoId  String?
  pedido    Pedido?         @relation(fields: [pedidoId], references: [id])
  pagoId    String?         @unique
  pago      Pago?           @relation(fields: [pagoId], references: [id])
  origen    OrigenArchivo   @default(CLIENTE)
  tipo      String
  url       String
  nombre    String?

  createdAt DateTime        @default(now())

  @@index([pedidoId])
}

model SolicitudCambio {
  id               String                @id @default(cuid())
  pedidoId         String
  pedido           Pedido                @relation(fields: [pedidoId], references: [id])
  descripcion      String
  estado           EstadoSolicitudCambio @default(ABIERTA)
  origen           OrigenSolicitudCambio @default(ADMIN)
  creadorPor       String?
  respuestaCliente String?
  respuestaAt      DateTime?
  createdAt        DateTime              @default(now())
  resueltoAt       DateTime?

  comentarios      ComentarioSolicitud[]

  @@index([pedidoId])
  @@index([estado])
}

model ComentarioSolicitud {
  id               String   @id @default(cuid())
  solicitudId      String
  solicitud        SolicitudCambio @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  contenido        String
  autor            String
  origen           OrigenSolicitudCambio
  visibleCliente   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([solicitudId])
}

model ProduccionAvance {
  id         String             @id @default(cuid())
  pedidoId   String
  pedido     Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo       TipoMedioProduccion
  url        String
  nombre     String?
  titulo     String?
  descripcion String?
  usuarioId  String?
  usuario    Usuario?           @relation(fields: [usuarioId], references: [id])
  orden      Int                @default(0)
  visibleCliente Boolean        @default(true)

  createdAt  DateTime           @default(now())

  @@index([pedidoId])
  @@index([pedidoId, orden])
}

model ComentarioProduccion {
  id         String             @id @default(cuid())
  pedidoId   String
  pedido     Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  contenido  String
  visibilidad VisibilidadComentario @default(INTERNO)
  usuarioId  String?
  usuario    Usuario?           @relation(fields: [usuarioId], references: [id])
  autorNombre String?

  createdAt  DateTime           @default(now())

  @@index([pedidoId])
  @@index([pedidoId, visibilidad])
}

model EventoTimeline {
  id             String             @id @default(cuid())
  pedidoId       String
  pedido         Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo           TipoEventoTimeline
  estadoAnterior EstadoPedido?
  estadoNuevo    EstadoPedido?
  descripcion    String?
  usuarioId      String?
  usuario        Usuario?           @relation(fields: [usuarioId], references: [id])
  metadata       Json?

  createdAt      DateTime           @default(now())

  @@index([pedidoId])
  @@index([createdAt])
}

model Configuracion {
  id          String   @id @default(cuid())
  clave       String   @unique
  valor       Json
  descripcion String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
