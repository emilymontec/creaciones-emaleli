# ============================================================
# CREACIONES EMALELI — Variables de entorno
# Copia este archivo a .env (o .env.local) y completa los valores.
# Nunca subas .env a control de versiones.
# ============================================================

# --- Base de datos (Prisma) ---

# Conexión de RUNTIME con pooling (pgbouncer, puerto 6543).
# Es la que usa la aplicación (Prisma Client).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Conexión DIRECTA para migraciones (session pooler, puerto 5432).
# La usa el CLI de Prisma (migrate/deploy).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase ---

# URL del proyecto (Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Clave anon (pública, segura para el navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key (SOLO server-side, NUNCA en el navegador).
SUPABASE_SERVICE_ROLE_KEY=""

# Bucket de Supabase Storage donde se guardan las fotos de productos y
# categorías (galería, imagen principal, imagen por variante). Se crea
# automáticamente al correr `pnpm storage:setup`. Opcional: si se deja
# vacío se usa "productos" por defecto.
SUPABASE_BUCKET_PRODUCTOS="productos"

# --- Aplicación ---

NEXT_PUBLIC_APP_NAME="Emaleli"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Número WhatsApp de la empresa (formato internacional sin + ni espacios, ej: 573001234567)
# Se usa tanto para el botón "coordinar pedido" del carrito como el CTA del checkout.
NEXT_PUBLIC_EMPRESA_WHATSAPP="573001234567"

# Secreto para firmar las sesiones (JWT). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""
